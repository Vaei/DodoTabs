# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
dist-ssr/
*.local
# Convenience shortcut to the built installer (points into target/)
*.lnk

# ---- Logs & caches ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo

# ---- Environment ----
.env
.env.*
!.env.example

# ---- Rust / Tauri ----
src-tauri/target/
# Generated by the Tauri build (capability/permission schemas)
src-tauri/gen/schemas/
# Source-image used to generate the icon set (icons/ is committed)
src-tauri/icon-source.png

# ---- Signing secrets (NEVER commit; back these up separately) ----
# Tauri updater private key (public key lives in tauri.conf.json)
src-tauri/updater_key
src-tauri/updater_key.pub
# Android release keystore + its credentials
*.jks
*.keystore
src-tauri/gen/android/key.properties

# ---- Editors / IDEs ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
