{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DodoTabs",
  "version": "1.0.0",
  "identifier": "com.dodotabs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DodoTabs",
        "width": 1408,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Vaei/DodoTabs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RTI1MkNFNEYzNjM1NTIKUldSU05UWlB6bExpMTk1YlJpTE1CdkRhNEhHdlphbW9qQzkwajBScWlubWxzOGdvZUtNdnBQRmwK"
    }
  }
}
