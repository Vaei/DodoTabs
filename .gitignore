# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build output ----
dist/
dist-ssr/
*.local

# alphaTab assets copied into the build at dev/build time (sourced from node_modules)
public/font/
public/soundfont/

# ---- Logs & caches ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
